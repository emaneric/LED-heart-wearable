{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open RTT Viewer",
            "type": "shell",
            "command": "sleep 4 && JLinkRTTClient",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [{ "regexp": "^$", "file": 1, "location": 2, "message": 3 }],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^$",
                        "endsPattern": "^$"
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "title": "RTT Viewer"
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "pkill -f JLinkGDBServer; cube-cmake --build ${workspaceFolder}/build/Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
